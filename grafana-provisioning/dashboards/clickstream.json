                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.21.2",
                        "queryType": "table",
                        "rawSql": "SELECT \r\n  case level\r\n    when 1 then '1. Home'\r\n    when 2 then '2. Product'\r\n    when 3 then '3. Cart'\r\n    when 4 then '4. Checkout'\r\n  end AS step_name,\r\n  count() AS users\r\nFROM(\r\n  SELECT\r\n    user_id,\r\n    windowFunnel(1800)(\r\n      event_time,\r\n      page_url = '/home',\r\n      page_url = '/product/detail',\r\n      page_url = '/cart',\r\n      page_url = '/checkout'\r\n    ) AS level\r\n  FROM default.clickstream_records\r\n  WHERE event_time >= $__fromTime AND event_time <= $__toTime\r\n    AND site_id IN ($site_id)\r\n    AND device_type IN ($device_type)\r\n  GROUP BY user_id\r\n)\r\nWHERE level > 0\r\nGROUP BY level, step_name\r\nORDER BY level ASC;"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
