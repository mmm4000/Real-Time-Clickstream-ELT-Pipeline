                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
